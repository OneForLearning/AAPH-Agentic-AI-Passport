FROM python:3.12-slim AS build
COPY agent ./agent
RUN pip wheel --timeout 120 --no-cache-dir --wheel-dir /wheels ./agent

FROM python:3.12-slim
RUN groupadd --system --gid 10001 aaph && useradd --system --uid 10001 --gid aaph --no-create-home aaph
COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir /wheels/aaph_agent-*.whl && rm -rf /wheels
USER 10001:10001
WORKDIR /app
ENTRYPOINT ["aaph-agent"]
