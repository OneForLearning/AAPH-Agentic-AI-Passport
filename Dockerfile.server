# syntax=docker/dockerfile:1.7
FROM rust:1.84-bookworm AS build
WORKDIR /src
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse \
    CARGO_HTTP_TIMEOUT=600 \
    CARGO_NET_RETRY=10
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --locked --release -p aaph-server

FROM debian:bookworm-slim
RUN groupadd --system --gid 10001 aaph \
    && useradd --system --uid 10001 --gid aaph --no-create-home aaph \
    && mkdir -p /data/authority /data/pep /data/workspace/inbox /data/workspace/output \
    && chown -R 10001:10001 /data
COPY --from=build /src/target/release/aaph-server /usr/local/bin/aaph-server
USER 10001:10001
WORKDIR /app
ENTRYPOINT ["aaph-server"]
